# ytb-dl-web all-in-one image — Gharmonize web downloader + chrome-driverless embedded
# browser (log into NetEase / QQ Music / Bilibili in a built-in tab) + ffmpeg/yt-dlp binaries.
#
# Build context note: place the chrome-driverless sources at ./chrome-driverless/
# before building (e.g. the submodule), so this image can bundle both services.
#
# Runtime: two processes via docker-entrypoint.sh
#   - uvicorn chrome-driverless :9223 (headed browser under Xvfb)
#   - node app.js (Gharmonize)        :5174

FROM docker-mirror.internal.example/library/python:3.11-slim-bookworm

WORKDIR /srv

ARG DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates tzdata curl xz-utils unzip \
        xvfb x11-utils x11-xserver-utils \
        libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
        fonts-wqy-zenhei fonts-wqy-microhei \
        ffmpeg nodejs npm; \
    rm -rf /var/lib/apt/lists/*

# Playwright + chrome-driverless runtime deps
RUN pip install --no-cache-dir playwright fastapi uvicorn pydantic Pillow

# Install the playwright chromium build (system deps already installed above)
RUN python -m playwright install chromium

# -- Gharmonize (node app) --
WORKDIR /usr/src/app
COPY package*.json ./
RUN set -eux; \
    export NPM_CONFIG_LOGLEVEL=warn NPM_CONFIG_IGNORE_SCRIPTS=true NPM_CONFIG_UPDATE_NOTIFIER=false; \
    if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi; \
    rm -rf /root/.npm
COPY . .

# chrome-driverless sources (vendored submodule)
COPY chrome-driverless /opt/chrome-driverless
RUN cd /opt/chrome-driverless/scripts 2>/dev/null && (npm ci --ignore-scripts 2>/dev/null || true)

ENV NODE_ENV=production \
    PORT=5174 \
    GHARMONIZE_HOST=0.0.0.0 \
    GHARMONIZE_WEB_BINARIES_IN_DOCKER=1 \
    GHARMONIZE_WEB_CACHE_DIR=/opt/gharmonize/cache/binaries \
    DISABLE_QSV_IN_DOCKER=1 \
    DISABLE_VAAPI_IN_DOCKER=1 \
    CHROME_DRIVERLESS_URL=http://127.0.0.1:9223 \
    BROWSER_DATA_DIR=/opt/gharmonize/browser-data \
    PROFILE_NAME=default

RUN mkdir -p /usr/src/app/uploads /usr/src/app/outputs /usr/src/app/temp \
             /usr/src/app/local-inputs /usr/src/app/cookies \
             /opt/gharmonize/cache/binaries /opt/gharmonize/browser-data \
    && chmod -R 0775 /usr/src/app /opt/gharmonize
COPY docker-entrypoint.sh /usr/src/app/docker-entrypoint.sh
RUN chmod +x /usr/src/app/docker-entrypoint.sh

EXPOSE 5174 9223 9222

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 5174) + '/').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

ENTRYPOINT ["/usr/src/app/docker-entrypoint.sh"]